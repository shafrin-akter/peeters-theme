{% liquid
  assign title = section.settings.title
  assign content = section.settings.content

  assign icon_01 = section.settings.icon_01
  assign feature_01 = section.settings.feature_01
  assign icon_02 = section.settings.icon_02
  assign feature_02 = section.settings.feature_02


  assign placeholder = section.settings.placeholder
  assign search_btn_tex = section.settings.search_btn_tex
%}

<section class="color-{{section.settings.color_scheme}} gradient">
  <div class="page-width">
    <h1>Lorem ipsum dolor sit amet consectetur adipisicing elit. Possimus, commodi.</h1>
  </div>
</section>


{% schema %}
  {
    "name": "Hero Banner",
    "class": "hero_banner",
    "tag": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "inline_richtext",
        "id": "title",
        "label": "Title",
        "default": "Wij houden van fietsen"
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Content",
        "default": "Ultiem fietsplezier door middel van optimale service, kwaliteit en vakmanschap. Dat staat bij ons voorop!"
      },
      {
        "type": "header",
        "content": "Feature"
      },
      {
        "type": "image_picker",
        "id": "icon_01",
        "label": "Icon"
      },
      {
        "type": "text",
        "id": "feature_01",
        "label": "Feture Text",
        "default": "Plan een advies gesprek"
      },
      {
        "type": "image_picker",
        "id": "icon_02",
        "label": "Icon"
      },
      {
        "type": "text",
        "id": "feature_02",
        "label": "Feture Text",
        "default": "Plan een service gesprek"
      },
      {
        "type": "header",
        "content": "Search content"
      },
      {
        "type": "text",
        "label": "Search Placeholder",
        "id": "placeholder",
        "default": "Plan een service gesprek"
      },
      {
        "type": "text",
        "id": "search_btn_tex",
        "label": "Search Button Text",
        "default": "ZOEKEN"
      },
      {
        "type": "header",
        "content": "Section Style"
      },
      {
        "type": "color_scheme",
        "label": "Section Colo",
        "default": "scheme_5",
        "id": "color_scheme"
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "slide",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero Banner"
      }
    ]
  }
{% endschema %}